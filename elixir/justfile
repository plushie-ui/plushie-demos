set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    just --list

preflight:
    for mixfile in */mix.exs; do \
      demo="${mixfile%/mix.exs}"; \
      echo "==> elixir/$demo"; \
      ( \
        cd "$demo"; \
        mix deps.get; \
        mix format --check-formatted; \
        mix compile --warnings-as-errors; \
        if [ -d native ]; then \
          mix run --no-start -e 'app = Mix.Project.config()[:app]; Enum.each(Application.spec(app, :modules) || [], &Code.ensure_loaded/1); Plushie.WidgetRegistry.invalidate(); Mix.Task.run("plushie.build")'; \
          PLUSHIE_BINARY_PATH="$(find _build/plushie/bin -maxdepth 1 -type f -perm -111 | sort | head -n 1)"; \
          export PLUSHIE_BINARY_PATH; \
        fi; \
        mix test; \
        if grep -q "dialyxir" mix.exs; then mix dialyzer; fi \
      ); \
    done

package-smoke:
    PACKAGE_SMOKE_BUILD=1 ../scripts/package_smoke.sh elixir
