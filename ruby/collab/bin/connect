#!/usr/bin/env ruby
# frozen_string_literal: true

# Run the collab app from a standalone entry point.
#
# Used with structured renderer exec args for remote rendering:
#   plushie --exec-bin bundle --exec-arg exec --exec-arg ruby --exec-arg bin/connect
#
# Or over SSH:
#   plushie --exec-bin ssh --exec-arg -T --exec-arg host --exec-arg 'cd /path/to/collab && bundle exec ruby bin/connect'

require_relative "../lib/collab"

Plushie.connect(Collab)
