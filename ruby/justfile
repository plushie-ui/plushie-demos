set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    just --list

preflight:
    for gemfile in */Gemfile; do \
      demo="${gemfile%/Gemfile}"; \
      echo "==> ruby/$demo"; \
      ( \
        cd "$demo"; \
        sdk_root="$PWD/../../../plushie-ruby"; \
        if [ -d "$sdk_root/lib/plushie" ]; then \
          export RUBYLIB="$sdk_root/lib:${RUBYLIB:-}"; \
        fi; \
        rust_root="${PLUSHIE_RUST_SOURCE_PATH:-$PWD/../../../plushie-rust}"; \
        if [ -z "${PLUSHIE_RUST_SOURCE_PATH:-}" ] && [ -f "$rust_root/Cargo.toml" ]; then \
          export PLUSHIE_RUST_SOURCE_PATH="$rust_root"; \
        fi; \
        if [ -z "${PLUSHIE_BINARY_PATH:-}" ] && [ -x "$rust_root/target/release/plushie-renderer" ]; then \
          export PLUSHIE_BINARY_PATH="$rust_root/target/release/plushie-renderer"; \
        fi; \
        bundle check || bundle install; \
        if [ -d native ]; then \
          bundle exec rake plushie:build; \
          PLUSHIE_BINARY_PATH="$(find _build/plushie/bin -maxdepth 1 -type f -perm -111 | sort | head -n 1)"; \
          export PLUSHIE_BINARY_PATH; \
        fi; \
        bundle exec rake \
      ); \
    done

package-postcheck:
    PACKAGE_POSTCHECK_BUILD=1 ../scripts/package_postcheck.sh ruby
