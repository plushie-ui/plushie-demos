#!/usr/bin/env bash
#
# Build a custom plushie binary with the crash_widget extension.
#
# Requires:
#   - Rust toolchain (rustc >= 1.92)
#
# Usage:
#   bin/build            # debug build
#   bin/build --release  # optimised build
#
# Environment:
#   PLUSHIE_SOURCE_PATH  Path to local plushie-rust checkout.
#                        Uses path deps and [patch.crates-io] for
#                        local development. Falls back to published
#                        crates when unset.

set -euo pipefail
cd "$(dirname "$0")/.."

RELEASE=""
PROFILE="debug"
for arg in "$@"; do
  case "$arg" in
    --release) RELEASE="--release"; PROFILE="release" ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

BUILD_DIR="_build/custom_binary"
mkdir -p "$BUILD_DIR/src"

CRASH_CRATE="$(pwd)/native/crash_widget"

if [ -n "${PLUSHIE_SOURCE_PATH:-}" ]; then
  cat > "$BUILD_DIR/Cargo.toml" <<EOF
[package]
name = "crash-lab-plushie"
version = "0.1.0"
edition = "2024"

[dependencies]
plushie-widget-sdk = { path = "${PLUSHIE_SOURCE_PATH}/crates/plushie-widget-sdk" }
plushie-renderer = { path = "${PLUSHIE_SOURCE_PATH}/crates/plushie-renderer" }
crash_widget = { path = "$CRASH_CRATE" }
EOF

  # Add [patch.crates-io] if the source workspace defines one
  if grep -q '^\[patch.crates-io\]' "${PLUSHIE_SOURCE_PATH}/Cargo.toml" 2>/dev/null; then
    echo "" >> "$BUILD_DIR/Cargo.toml"
    echo "[patch.crates-io]" >> "$BUILD_DIR/Cargo.toml"
    sed -n '/^\[patch.crates-io\]/,/^\[/{/^\[patch.crates-io\]/d;/^\[/d;p}' \
      "${PLUSHIE_SOURCE_PATH}/Cargo.toml" >> "$BUILD_DIR/Cargo.toml"
  fi
else
  cat > "$BUILD_DIR/Cargo.toml" <<EOF
[package]
name = "crash-lab-plushie"
version = "0.1.0"
edition = "2024"

[dependencies]
plushie-widget-sdk = "0.6"
plushie-renderer = "0.6"
crash_widget = { path = "$CRASH_CRATE" }
EOF
fi

# Generate main.rs
cat > "$BUILD_DIR/src/main.rs" <<'EOF'
fn main() -> plushie_widget_sdk::iced::Result {
    let builder = plushie_widget_sdk::app::PlushieAppBuilder::new()
        .widget(crash_widget::CrashExtension::new());
    plushie_renderer::run(builder)
}
EOF

echo "Building custom binary ($PROFILE)..."
cargo build $RELEASE --manifest-path "$BUILD_DIR/Cargo.toml"

# Install
BINARY="$BUILD_DIR/target/$PROFILE/crash-lab-plushie"
INSTALL_DIR="build/plushie/bin"
mkdir -p "$INSTALL_DIR"
cp "$BINARY" "$INSTALL_DIR/crash-lab-plushie"

echo "Installed: $INSTALL_DIR/crash-lab-plushie"
