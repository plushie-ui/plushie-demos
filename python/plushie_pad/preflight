#!/usr/bin/env bash
# Mirrors CI. Run before committing.
set -euo pipefail

echo "==> ruff format --check"
ruff format --check plushie_pad tests

echo "==> ruff check"
ruff check plushie_pad tests

echo "==> pyright"
pyright plushie_pad tests

echo "==> pytest"
pytest

echo ""
echo "All checks passed."
